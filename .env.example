# ==============================================================================
# HADESGATE — CONFIGURAÇÕES ESSENCIAIS DE BOOT & SEGURANÇA
# ==============================================================================
# Todas as políticas de DLP, Tenants, Webhooks, Egress Scanning e Modelos Locais
# são gerenciadas dinamicamente no Console Web (ícone ⚙ no canto superior direito),
# persistidas com segurança no SQLite e recarregadas a quente com zero downtime.
#
# O arquivo .env destina-se EXCLUSIVAMENTE às credenciais e variáveis essenciais de boot:
# ==============================================================================

# 1. Servidor e Rede
PORT=8080
# Seguro por padrão para execução local (127.0.0.1).
# O Docker Compose sobrescreve automaticamente para 0.0.0.0 dentro do container.
HADESGATE_BIND_ADDRESS=127.0.0.1

# 2. Chaves de Segurança e Criptografia
# Chave administrativa mestre de bootstrap/recuperação (papel admin).
# Credenciais adicionais (viewer/operator/admin) são geradas na aba Governança.
# O valor abaixo é PÚBLICO: troque antes de expor o gateway em rede.
# Gere com: openssl rand -base64 32
HADESGATE_ADMIN_KEY=hadesgate_sec_admin_key_2026

# OBRIGATÓRIA: Chave mestra AES-256 externa ao SQLite (32 bytes em base64 ou hex).
# Criptografa segredos operacionais, webhooks, tenants e backups.
# Gere uma vez com: openssl rand -base64 32
# Ou no PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
HADESGATE_CONFIG_MASTER_KEY=

# Segredo HMAC estável (mínimo 32 bytes) para fingerprintar chaves BYOK de clientes.
# A chave original do provedor nunca é gravada em disco.
HADESGATE_FINGERPRINT_SECRET=troque_por_32_bytes_aleatorios_ou_mais

# Chave de proxy HadesGate opcional para clientes que não usam BYOK transparente.
# Deve ser diferente da chave administrativa.
HADESGATE_PROXY_KEY=

# 3. Segurança Web (CORS & Egress DLP)
# Origens autorizadas a se comunicar com a API administrativa.
HADESGATE_CORS_ALLOWED_ORIGINS=http://localhost:8080

# Inspeciona respostas JSON e streams SSE da IA para bloquear novos dados sensíveis.
HADESGATE_ENABLE_EGRESS_SCAN=true

# 4. Banco de Dados SQLite Local
HADESGATE_DB_PATH=./data/hadesgate.db

# ==============================================================================
# CREDENCIAIS UPSTREAM DAS LLMS (CONFIGURE AS QUE UTILIZAR)
# ==============================================================================

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Endpoints upstream padrão (opcional caso utilize provedores oficiais)
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
OLLAMA_BASE_URL=http://localhost:11434/v1
